#!/bin/sh
set -e

echo "[ Condtux ] Configurando repositorios APT..."

cat > /etc/apt/sources.list <<'EOF'
deb http://deb.debian.org/debian trixie main
deb http://deb.debian.org/debian trixie-updates main
deb http://security.debian.org/debian-security trixie-security main
EOF

rm -f /etc/apt/sources.list.d/condtux.sources
rm -f /etc/apt/sources.list.d/condtux.sources.disabled

if [ -f /usr/share/keyrings/condtux-archive-keyring.gpg ]; then
    cat > /etc/apt/sources.list.d/condtux.sources <<'EOF'
Types: deb
URIs: https://repo-condtux.jeval.cl/apt
Suites: trixie
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/condtux-archive-keyring.gpg
EOF
    echo "[ Condtux ] Repo Condtux activo."
else
    cat > /etc/apt/sources.list.d/condtux.sources.disabled <<'EOF'
# Condtux repo - falta /usr/share/keyrings/condtux-archive-keyring.gpg.
#
# Types: deb
# URIs: https://repo-condtux.jeval.cl/apt
# Suites: trixie
# Components: main
# Architectures: amd64
# Signed-By: /usr/share/keyrings/condtux-archive-keyring.gpg
EOF
    echo "[ Condtux ] Repo Condtux desactivado: falta keyring."
fi

echo "[ Condtux ] Repositorios APT listos."
