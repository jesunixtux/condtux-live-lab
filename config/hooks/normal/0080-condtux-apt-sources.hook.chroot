#!/bin/sh
set -e

echo "[ Condtux ] Configurando repositorios APT Debian limpios..."

cat > /etc/apt/sources.list <<'EOF'
deb http://deb.debian.org/debian trixie main
deb http://deb.debian.org/debian trixie-updates main
deb http://security.debian.org/debian-security trixie-security main
EOF

rm -f /etc/apt/sources.list.d/condtux.sources

cat > /etc/apt/sources.list.d/condtux.sources.disabled <<'EOF'
# Condtux repo - desactivado temporalmente en la ISO 0.5.
# Se activará cuando repo-condtux.jeval.cl tenga Release firmado y keyring.
#
# Types: deb
# URIs: https://repo-condtux.jeval.cl/apt
# Suites: trixie
# Components: main
# Architectures: amd64
# Signed-By: /usr/share/keyrings/condtux-archive-keyring.gpg
EOF

echo "[ Condtux ] Repositorios Debian listos. Repo Condtux desactivado temporalmente."
