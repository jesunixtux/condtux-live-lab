#!/bin/sh
set -e

echo "[ Condtux ] Configurando repositorios APT híbridos..."

mkdir -p /etc/apt/sources.list.d
mkdir -p /etc/apt/preferences.d

cat > /etc/apt/sources.list <<'APT'
# Condtux uses /etc/apt/sources.list.d/*.sources
APT

cat > /etc/apt/sources.list.d/condtux.sources <<'APT'
Types: deb
URIs: https://repo-condtux.jeval.cl/apt
Suites: trixie
Components: main
Architectures: amd64
Trusted: yes

Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main
Architectures: amd64

Types: deb
URIs: http://security.debian.org/debian-security
Suites: trixie-security
Components: main
Architectures: amd64
APT

cat > /etc/apt/preferences.d/condtux.pref <<'EOF_PREF'
Package: *
Pin: origin repo-condtux.jeval.cl
Pin-Priority: 700

Package: *
Pin: release o=Debian
Pin-Priority: 500
EOF_PREF

cat > /etc/apt/apt.conf.d/99condtux <<'APTCONF'
APT::Install-Recommends "false";
APT::Install-Suggests "false";
Acquire::Retries "3";
APTCONF

apt-get clean || true

echo "[ Condtux ] Repositorios híbridos listos."
