#!/bin/sh
set -e

echo "[ Condtux ] Configurando repositorios APT Debian..."

mkdir -p /etc/apt/sources.list.d

rm -f /etc/apt/sources.list
rm -f /etc/apt/sources.list.d/*.list
rm -f /etc/apt/sources.list.d/*.sources

cat > /etc/apt/sources.list <<'APT'
deb http://deb.debian.org/debian trixie main
deb http://deb.debian.org/debian trixie-updates main
deb http://security.debian.org/debian-security trixie-security main
APT

cat > /etc/apt/apt.conf.d/99condtux <<'APTCONF'
APT::Install-Recommends "false";
APT::Install-Suggests "false";
Acquire::Retries "3";
APTCONF

cat > /usr/local/sbin/condtux-fix-apt <<'SCRIPT'
#!/bin/sh
set -e

rm -f /etc/apt/sources.list.d/*.list
rm -f /etc/apt/sources.list.d/*.sources

cat > /etc/apt/sources.list <<'APT'
deb http://deb.debian.org/debian trixie main
deb http://deb.debian.org/debian trixie-updates main
deb http://security.debian.org/debian-security trixie-security main
APT

rm -rf /var/lib/apt/lists/*
apt-get update || true
SCRIPT

chmod +x /usr/local/sbin/condtux-fix-apt

cat > /etc/systemd/system/condtux-fix-apt.service <<'UNIT'
[Unit]
Description=Condtux first boot APT repair
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/condtux-fix-apt
ExecStartPost=/bin/systemctl disable condtux-fix-apt.service

[Install]
WantedBy=multi-user.target
UNIT

systemctl enable condtux-fix-apt.service || true

apt-get clean

echo "[ Condtux ] Repositorios APT listos."
