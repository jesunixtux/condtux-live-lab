#!/bin/sh
set -u

REPO_URL="https://repo-condtux.jeval.cl/apt/dists/trixie/InRelease"
PACKAGE="condtux-repo-test"
KEYRING=/usr/share/keyrings/condtux-archive-keyring.gpg
SOURCES=/etc/apt/sources.list.d/condtux.sources

retry() {
    attempts="$1"
    delay="$2"
    shift 2

    i=1
    while [ "$i" -le "$attempts" ]; do
        if "$@"; then
            return 0
        fi

        echo "[ Condtux ] Intento $i/$attempts fallido; reintentando en ${delay}s..." >&2
        sleep "$delay"
        i=$((i + 1))
    done

    return 1
}

echo "[ Condtux ] Probando repo Condtux con $PACKAGE..."

for command_name in curl apt-get apt-cache; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "[ Condtux ] ERROR: falta $command_name; el chroot no contiene el perfil base completo." >&2
        exit 1
    fi
done

if [ ! -s "$KEYRING" ] || [ ! -s "$SOURCES" ]; then
    echo "[ Condtux ] ERROR: repo Condtux incompleto; falta keyring o archivo sources." >&2
    exit 1
fi

if ! retry 4 10 curl -fsSIL --connect-timeout 15 "$REPO_URL" >/dev/null; then
    echo "[ Condtux ] ADVERTENCIA: repo Condtux no disponible temporalmente; se omite la prueba de red." >&2
    exit 0
fi

if ! retry 4 10 apt-get -o Acquire::Retries=3 update; then
    echo "[ Condtux ] ADVERTENCIA: apt update fallo tras varios intentos; se omite la prueba del repo." >&2
    exit 0
fi

if ! apt-cache show "$PACKAGE" >/dev/null 2>&1; then
    echo "[ Condtux ] ADVERTENCIA: $PACKAGE no esta publicado; la ISO continuara sin el paquete de prueba." >&2
    exit 0
fi

if ! retry 3 10 apt-get -o Acquire::Retries=3 install -y --no-install-recommends "$PACKAGE"; then
    echo "[ Condtux ] ADVERTENCIA: no se pudo instalar $PACKAGE; la ISO continuara." >&2
    exit 0
fi

condtux-repo-test || true

echo "[ Condtux ] Repo Condtux probado correctamente."
