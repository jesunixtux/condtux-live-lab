#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none

APT_OPTIONS="-o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30"

echo "[ Condtux ] Instalando XFCE 4.20 estable desde Debian trixie..."

# Condtux 0.11 usa una sola implementacion de XFCE. El paquete monolitico
# condtux-xfce-desktop 0.8.0 queda fuera de la ISO porque duplicaba archivos de
# xfconf y libxfce4util con los paquetes de Debian.
apt-get $APT_OPTIONS update
apt-get $APT_OPTIONS install -y --no-install-recommends \
    xfce4 \
    xfce4-power-manager \
    xfce4-notifyd \
    thunar-volman \
    xserver-xorg-core \
    xserver-xorg-input-libinput \
    xserver-xorg-video-amdgpu \
    xserver-xorg-video-ati \
    xserver-xorg-video-intel \
    xserver-xorg-video-nouveau \
    xserver-xorg-video-vesa \
    xserver-xorg-video-fbdev \
    xserver-xorg-video-vmware \
    xinit \
    xauth \
    x11-xserver-utils \
    lightdm \
    lightdm-gtk-greeter \
    xterm \
    network-manager-gnome \
    policykit-1-gnome \
    polkitd \
    pkexec \
    dbus-x11 \
    dbus-user-session \
    pipewire-audio \
    fonts-dejavu-core \
    hicolor-icon-theme

for package in xfce4 xfce4-session xfconf xfce4-settings xfdesktop4 xfwm4 lightdm; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
        echo "[ Condtux ] ERROR: no se instalo correctamente $package." >&2
        exit 1
    fi
done

for command_name in startxfce4 xfce4-session xfconf-query xfwm4 xfdesktop lightdm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "[ Condtux ] ERROR: falta el comando XFCE requerido: $command_name" >&2
        exit 1
    fi
done

# xfconfd es un daemon libexec y Debian no tiene por que ponerlo en PATH.
XFCONFD_PATH="$(dpkg -L xfconf 2>/dev/null | awk '/\/xfconfd$/ { print; exit }')"
if [ -z "$XFCONFD_PATH" ] || [ ! -x "$XFCONFD_PATH" ]; then
    echo "[ Condtux ] ERROR: xfconf esta instalado, pero no contiene xfconfd ejecutable." >&2
    exit 1
fi
install -d -m 0755 /usr/local/bin
ln -sfn "$XFCONFD_PATH" /usr/local/bin/xfconfd

DBUS_SERVICE=/usr/share/dbus-1/services/org.xfce.Xfconf.service
if [ ! -f "$DBUS_SERVICE" ]; then
    echo "[ Condtux ] ERROR: falta el servicio D-Bus de xfconf: $DBUS_SERVICE" >&2
    exit 1
fi
if ! grep -q '^Name=org\.xfce\.Xfconf$' "$DBUS_SERVICE"; then
    echo "[ Condtux ] ERROR: el servicio D-Bus de xfconf es invalido." >&2
    exit 1
fi

# Verifica que los componentes principales puedan resolver sus bibliotecas.
for binary in "$(command -v xfce4-session)" "$XFCONFD_PATH" "$(command -v xfwm4)"; do
    if ldd "$binary" 2>/dev/null | grep -q 'not found'; then
        echo "[ Condtux ] ERROR: bibliotecas sin resolver en $binary" >&2
        ldd "$binary" >&2 || true
        exit 1
    fi
done

if dpkg --audit | grep -q .; then
    echo "[ Condtux ] ERROR: dpkg detecto paquetes incompletos:" >&2
    dpkg --audit >&2
    exit 1
fi

if dpkg-query -W -f='${Status}' condtux-xfce-desktop 2>/dev/null | grep -q 'install ok installed'; then
    echo "[ Condtux ] ERROR: se instalo accidentalmente condtux-xfce-desktop." >&2
    exit 1
fi

# El Live entra primero en consola para seleccionar idioma y teclado. XFCE se
# activa despues con condtux-live-xfce.
systemctl set-default multi-user.target || true
systemctl disable lightdm || true
systemctl disable ssh.service ssh.socket 2>/dev/null || true
systemctl disable bluetooth.service cups.service 2>/dev/null || true

echo "[ Condtux ] XFCE estable instalado y validado correctamente."