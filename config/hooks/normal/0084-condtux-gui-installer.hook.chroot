#!/bin/sh
set -eu

echo "[ Condtux ] Preparando lanzador visual del instalador..."

chmod 0755 /usr/local/bin/condtux-install-gui
chmod 0755 /etc/skel/Desktop/condtux-install.desktop

install -D -m 0644 \
    /etc/skel/Desktop/condtux-install.desktop \
    /usr/share/applications/condtux-install.desktop

echo "[ Condtux ] Lanzador visual listo."
