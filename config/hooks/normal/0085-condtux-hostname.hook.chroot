#!/bin/sh
set -e

echo "[ Condtux ] Configurando hostname..."

echo "condtux" > /etc/hostname

cat > /etc/hosts <<'EOF'
127.0.0.1       localhost
127.0.1.1       condtux

::1             localhost ip6-localhost ip6-loopback
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters
EOF

echo "[ Condtux ] Hostname configurado como condtux."
