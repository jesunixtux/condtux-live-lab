#!/bin/sh
set -eu

echo "[ Condtux ] Preparando usuario Live condtux..."

if ! id condtux >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "Condtux Live User" condtux
fi

echo "condtux:live" | chpasswd
echo "root:live" | chpasswd

usermod -aG sudo,audio,video,plugdev,netdev condtux || true

mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/condtux-live <<'SUDO'
condtux ALL=(ALL) NOPASSWD:ALL
SUDO
chmod 0440 /etc/sudoers.d/condtux-live

mkdir -p /home/condtux/Desktop
if [ -f /etc/skel/Desktop/condtux-install.desktop ]; then
    cp -f /etc/skel/Desktop/condtux-install.desktop /home/condtux/Desktop/condtux-install.desktop
    chmod 0755 /home/condtux/Desktop/condtux-install.desktop
fi
chown -R condtux:condtux /home/condtux

mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'GETTY'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin condtux --noclear %I $TERM
GETTY

echo "[ Condtux ] Usuario Live listo."
