#!/bin/sh
set -eu

INSTALLER_ES=/usr/local/sbin/condtux-install
INSTALLER_EN=/usr/local/sbin/condtux-install-en

echo "[ Condtux ] Consolidando sesion XFCE e instalador..."

chmod 0755 \
    /usr/local/bin/condtux-startxfce4 \
    /usr/local/sbin/condtux-time-sync \
    /usr/local/sbin/condtux-copy-system-target
chmod 0644 /usr/share/xsessions/condtux-xfce.desktop

# El ajuste inicial de 0.11 ocultaba la sesion segura original de XFCE.
SESSION_OVERRIDE=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml
if [ -f "$SESSION_OVERRIDE" ] && \
   grep -q 'SaveOnExit' "$SESSION_OVERRIDE" && \
   ! grep -q 'Failsafe' "$SESSION_OVERRIDE"; then
    rm -f "$SESSION_OVERRIDE"
fi

for package in xfce4 xfce4-session xfconf xfce4-settings xfdesktop4 xfwm4 lightdm; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || {
        echo "[ Condtux ] ERROR: falta el paquete $package." >&2
        exit 1
    }
done

for command_name in startxfce4 xfce4-session xfconf-query xfwm4 xfdesktop lightdm; do
    command -v "$command_name" >/dev/null 2>&1 || {
        echo "[ Condtux ] ERROR: falta $command_name." >&2
        exit 1
    }
done

XFCONFD_PATH="$(dpkg -L xfconf 2>/dev/null | awk '/\/xfconfd$/ { print; exit }')"
if [ -z "$XFCONFD_PATH" ] || [ ! -x "$XFCONFD_PATH" ]; then
    echo "[ Condtux ] ERROR: xfconf no contiene un xfconfd ejecutable." >&2
    exit 1
fi
ln -sfn "$XFCONFD_PATH" /usr/local/bin/xfconfd

cat > /tmp/condtux-install-xfce-function <<'XFCE_FUNCTION'
install_xfce_desktop() {
  local xfconfd_path package command_name

  echo "[ Condtux ] Instalando escritorio XFCE estable..."

  apt install -y --no-install-recommends \
    xfce4 \
    xfce4-power-manager \
    xfce4-notifyd \
    thunar-volman \
    xserver-xorg-core \
    xserver-xorg-input-libinput \
    xserver-xorg-video-amdgpu \
    xserver-xorg-video-ati \
    xserver-xorg-video-intel \
    xserver-xorg-video-nouveau \
    xserver-xorg-video-vesa \
    xserver-xorg-video-fbdev \
    xserver-xorg-video-vmware \
    xinit \
    xauth \
    x11-xserver-utils \
    lightdm \
    lightdm-gtk-greeter \
    xterm \
    network-manager-gnome \
    policykit-1-gnome \
    polkitd \
    pkexec \
    dbus-x11 \
    dbus-user-session \
    pipewire-audio \
    fonts-dejavu-core \
    hicolor-icon-theme

  for package in xfce4 xfce4-session xfconf xfce4-settings xfdesktop4 xfwm4 lightdm; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
      echo "[ Condtux ] ERROR: no se instalo correctamente $package." >&2
      exit 1
    fi
  done

  for command_name in startxfce4 xfce4-session xfconf-query xfwm4 xfdesktop lightdm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      echo "[ Condtux ] ERROR: falta el comando $command_name." >&2
      exit 1
    fi
  done

  xfconfd_path="$(dpkg -L xfconf 2>/dev/null | awk '/\/xfconfd$/ { print; exit }')"
  if [ -z "$xfconfd_path" ] || [ ! -x "$xfconfd_path" ]; then
    echo "[ Condtux ] ERROR: xfconf no contiene xfconfd." >&2
    exit 1
  fi
  install -d -m 0755 /usr/local/bin
  ln -sfn "$xfconfd_path" /usr/local/bin/xfconfd

  if [ ! -x /usr/local/bin/condtux-startxfce4 ]; then
    cat > /usr/local/bin/condtux-startxfce4 <<'STARTXFCE'
#!/bin/sh
set -eu
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- startxfce4
fi
exec startxfce4
STARTXFCE
    chmod 0755 /usr/local/bin/condtux-startxfce4
  fi

  mkdir -p /usr/share/xsessions /etc/lightdm/lightdm.conf.d
  cat > /usr/share/xsessions/condtux-xfce.desktop <<'SESSION'
[Desktop Entry]
Version=1.0
Name=Condtux XFCE
Comment=Condtux desktop session
Exec=/usr/local/bin/condtux-startxfce4
TryExec=/usr/local/bin/condtux-startxfce4
Type=Application
DesktopNames=XFCE
SESSION

  cat > /etc/lightdm/lightdm.conf.d/50-condtux.conf <<'LIGHTDM'
[Seat:*]
user-session=condtux-xfce
greeter-session=lightdm-gtk-greeter
LIGHTDM

  if dpkg --audit | grep -q .; then
    echo "[ Condtux ] ERROR: dpkg quedo en estado inconsistente al instalar XFCE." >&2
    dpkg --audit >&2
    exit 1
  fi

  systemctl set-default graphical.target || true
  systemctl enable lightdm || true
}
XFCE_FUNCTION

cat > /tmp/condtux-account-override <<'ACCOUNT_OVERRIDE'
# CONDTUX_ACCOUNT_OVERRIDE_V3
configure_accounts() {
  local status group extra_groups=""

  case "$USER_PASSWORD_HASH" in
    '$6$'*) ;;
    *)
      echo "[ Condtux ] ERROR: hash de contrasena de usuario invalido." >&2
      exit 1
      ;;
  esac

  if [ "$INSTALL_USERNAME" != "condtux" ] && id condtux >/dev/null 2>&1; then
    userdel -r condtux >/dev/null 2>&1 || true
  fi

  rm -f /etc/sudoers.d/condtux-live /etc/sudoers.d/condtux
  rm -rf /etc/systemd/system/getty@tty1.service.d

  if ! id "$INSTALL_USERNAME" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --comment "$INSTALL_FULLNAME" "$INSTALL_USERNAME"
  else
    usermod --shell /bin/bash --comment "$INSTALL_FULLNAME" "$INSTALL_USERNAME"
  fi

  install -d -m 0750 -o "$INSTALL_USERNAME" -g "$INSTALL_USERNAME" "/home/$INSTALL_USERNAME"
  usermod --password "$USER_PASSWORD_HASH" "$INSTALL_USERNAME"
  passwd -u "$INSTALL_USERNAME" >/dev/null 2>&1 || true

  status="$(passwd -S "$INSTALL_USERNAME" 2>/dev/null | awk '{print $2}')"
  if [ "$status" != "P" ]; then
    echo "[ Condtux ] ERROR: la cuenta $INSTALL_USERNAME no quedo utilizable." >&2
    exit 1
  fi

  for group in audio video plugdev netdev; do
    if getent group "$group" >/dev/null 2>&1; then
      extra_groups="${extra_groups}${extra_groups:+,}$group"
    fi
  done
  [ -z "$extra_groups" ] || usermod -aG "$extra_groups" "$INSTALL_USERNAME"

  if [ "$ACCOUNT_MODE" = "root" ]; then
    case "$ROOT_PASSWORD_HASH" in
      '$6$'*) ;;
      *)
        echo "[ Condtux ] ERROR: hash de contrasena root invalido." >&2
        exit 1
        ;;
    esac
    gpasswd -d "$INSTALL_USERNAME" sudo >/dev/null 2>&1 || true
    usermod --password "$ROOT_PASSWORD_HASH" root
    passwd -u root >/dev/null 2>&1 || true
  else
    usermod -aG sudo "$INSTALL_USERNAME"
    passwd -l root >/dev/null 2>&1 || true
  fi

  chown -R "$INSTALL_USERNAME:$INSTALL_USERNAME" "/home/$INSTALL_USERNAME"
  echo "[ Condtux ] Cuenta $INSTALL_USERNAME creada y verificada."
}

configure_accounts
ACCOUNT_OVERRIDE

patch_installer() {
    file="$1"
    language="$2"

    [ -f "$file" ] || return 0

    # Sustituye por completo la funcion de escritorio antigua.
    awk '
        /^install_xfce_desktop\(\) \{/ {
            while ((getline line < "/tmp/condtux-install-xfce-function") > 0) print line
            close("/tmp/condtux-install-xfce-function")
            skipping = 1
            next
        }
        skipping && /^configure_accounts\(\) \{/ { skipping = 0 }
        !skipping { print }
    ' "$file" > "$file.tmp"
    mv "$file.tmp" "$file"

    # El perfil XFCE ya no depende del repo Condtux para construir el escritorio.
    awk '
        /^network_available\(\) \{/ { in_network = 1 }
        in_network && /^[[:space:]]*if \[ "\$INSTALL_PROFILE" = "xfce" \]; then$/ {
            skipping_repo = 1
            next
        }
        skipping_repo && /^[[:space:]]*fi$/ {
            skipping_repo = 0
            next
        }
        !skipping_repo { print }
        in_network && /^}$/ { in_network = 0 }
    ' "$file" > "$file.tmp"
    mv "$file.tmp" "$file"

    sed -i \
      -e '/^[[:space:]]*condtux-xfce-desktop \\$/d' \
      -e 's/El perfil XFCE tambien necesita el repo Condtux por HTTPS.//g' \
      "$file"

    if ! grep -q 'CONDTUX_ACCOUNT_OVERRIDE_V3' "$file"; then
        awk '
            $0 == "configure_accounts" && !inserted {
                while ((getline line < "/tmp/condtux-account-override") > 0) print line
                close("/tmp/condtux-account-override")
                inserted = 1
                next
            }
            { print }
        ' "$file" > "$file.tmp"
        mv "$file.tmp" "$file"
    fi

    if [ "$language" = "es" ]; then
        sed -i \
          -e 's/passwordbox "Password para $label"/passwordbox "Contrasena para $label\\n\\nLa escritura esta oculta por seguridad."/' \
          -e 's/passwordbox "Repite el password para $label"/passwordbox "Repite la contrasena para $label\\n\\nLa escritura esta oculta por seguridad."/' \
          "$file"
    else
        sed -i \
          -e 's/passwordbox "Password para $label"/passwordbox "Password for $label\\n\\nTyping is hidden for security."/' \
          -e 's/passwordbox "Repite el password para $label"/passwordbox "Repeat the password for $label\\n\\nTyping is hidden for security."/' \
          "$file"
    fi

    chmod 0755 "$file"
    bash -n "$file"
}

patch_installer "$INSTALLER_ES" es
patch_installer "$INSTALLER_EN" en

rm -f /tmp/condtux-install-xfce-function /tmp/condtux-account-override

echo "[ Condtux ] XFCE e instalador consolidados correctamente."