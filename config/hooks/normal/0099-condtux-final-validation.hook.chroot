#!/bin/sh
set -eu

echo "[ Condtux ] Ejecutando validacion final de la ISO..."

for installer in /usr/local/sbin/condtux-install /usr/local/sbin/condtux-install-en; do
    [ -f "$installer" ] || {
        echo "[ Condtux ] ERROR: falta $installer" >&2
        exit 1
    }

    sed -i \
      -e 's#trixie-updates main$#trixie-updates main non-free-firmware#g' \
      -e 's#trixie-security main$#trixie-security main non-free-firmware#g' \
      -e '/^[[:space:]]*systemctl enable ssh[[:space:]]*$/d' \
      -e '/^[[:space:]]*condtux-xfce-desktop \\$/d' \
      "$installer"

    bash -n "$installer"
    grep -q 'condtux-time-sync --required' "$installer"
    grep -q 'confirm_destructive_disk' "$installer"
    grep -q 'condtux-copy-system-target' "$installer"
    grep -q 'shimx64.efi' "$installer"
    grep -q 'systemctl enable nftables.service' "$installer"
    grep -q 'CONDTUX_ACCOUNT_OVERRIDE_V3' "$installer"
    grep -q 'apt install -y --no-install-recommends' "$installer"
    grep -q '^[[:space:]]*xfce4 \\' "$installer"
    grep -q '^[[:space:]]*xfce4-session' "$installer" || true

    if grep -q 'apt-cache show "$CONDTUX_XFCE_PACKAGE"' "$installer"; then
        echo "[ Condtux ] ERROR: el instalador aun depende del paquete XFCE monolitico." >&2
        exit 1
    fi
done

for script in \
    /usr/local/sbin/condtux-time-sync \
    /usr/local/sbin/condtux-copy-system-target \
    /usr/local/bin/condtux-install-gui \
    /usr/local/bin/condtux-startxfce4 \
    /etc/profile.d/condtux-xfce.sh \
    /etc/X11/Xsession.d/55condtux-xfce-environment; do
    sh -n "$script"
done

for package in xfce4 xfce4-session xfconf xfce4-settings xfdesktop4 xfwm4 lightdm; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
        echo "[ Condtux ] ERROR: paquete requerido incompleto: $package" >&2
        exit 1
    fi
done

for command_name in startxfce4 xfce4-session xfconfd xfconf-query xfwm4 xfdesktop lightdm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "[ Condtux ] ERROR: comando requerido ausente: $command_name" >&2
        exit 1
    fi
done

for binary in "$(command -v xfce4-session)" "$(command -v xfconfd)" "$(command -v xfwm4)"; do
    if ldd "$binary" 2>/dev/null | grep -q 'not found'; then
        echo "[ Condtux ] ERROR: bibliotecas sin resolver en $binary" >&2
        ldd "$binary" >&2 || true
        exit 1
    fi
done

if dpkg --audit | grep -q .; then
    echo "[ Condtux ] ERROR: dpkg detecto un estado inconsistente:" >&2
    dpkg --audit >&2
    exit 1
fi

if dpkg-query -W -f='${Status}' condtux-xfce-desktop 2>/dev/null | grep -q 'install ok installed'; then
    echo "[ Condtux ] ERROR: la ISO mezcla el antiguo paquete monolitico con XFCE Debian." >&2
    exit 1
fi

if [ -f /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml ] && \
   grep -q 'SaveOnExit' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml && \
   ! grep -q 'Failsafe' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml; then
    echo "[ Condtux ] ERROR: xfce4-session.xml sigue ocultando la sesion segura." >&2
    exit 1
fi

echo "[ Condtux 0.11 ] ISO validada: XFCE, cuentas, hora, seguridad y dpkg correctos."