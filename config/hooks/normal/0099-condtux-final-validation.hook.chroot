#!/bin/sh
set -eu

echo "[ Condtux ] Ejecutando validacion final de la ISO..."

for installer in /usr/local/sbin/condtux-install /usr/local/sbin/condtux-install-en; do
    [ -f "$installer" ] || {
        echo "[ Condtux ] ERROR: falta $installer" >&2
        exit 1
    }

    sed -i \
      -e 's#trixie-updates main$#trixie-updates main non-free-firmware#g' \
      -e 's#trixie-security main$#trixie-security main non-free-firmware#g' \
      -e '/^[[:space:]]*systemctl enable ssh[[:space:]]*$/d' \
      -e '/^[[:space:]]*condtux-xfce-desktop \\$/d' \
      "$installer"

    bash -n "$installer"

    if [ "$(grep -c '^install_xfce_desktop() {' "$installer")" -ne 1 ]; then
        echo "[ Condtux ] ERROR: install_xfce_desktop no quedo definido exactamente una vez en $installer" >&2
        exit 1
    fi
    if [ "$(grep -c '^configure_accounts() {' "$installer")" -ne 1 ]; then
        echo "[ Condtux ] ERROR: configure_accounts no quedo definido exactamente una vez en $installer" >&2
        exit 1
    fi

    grep -q 'condtux-time-sync --required' "$installer"
    grep -q 'confirm_destructive_disk' "$installer"
    grep -q 'condtux-copy-system-target' "$installer"
    grep -q 'shimx64.efi' "$installer"
    grep -q 'systemctl enable nftables.service' "$installer"
    grep -q 'CONDTUX_ACCOUNT_OVERRIDE_V3' "$installer"
    grep -q 'apt install -y --no-install-recommends' "$installer"
    grep -q '^[[:space:]]*xfce4 \\' "$installer"
    grep -q 'dpkg -L xfconf' "$installer"

    if grep -q 'apt-cache show "$CONDTUX_XFCE_PACKAGE"' "$installer"; then
        echo "[ Condtux ] ERROR: el instalador aun depende del XFCE monolitico." >&2
        exit 1
    fi

    # bash -n del instalador no analiza el contenido de su heredoc CHROOT. Lo
    # extraemos y comprobamos por separado para detectar errores antes de grabar
    # la ISO.
    chroot_test="/tmp/$(basename "$installer").chroot-test.sh"
    awk '
        /cat > "\$TARGET\/tmp\/condtux-chroot-setup\.sh" <<'"'"'CHROOT'"'"'/ {
            capture = 1
            next
        }
        capture && /^CHROOT$/ { exit }
        capture { print }
    ' "$installer" > "$chroot_test"

    if [ ! -s "$chroot_test" ]; then
        echo "[ Condtux ] ERROR: no se pudo extraer el script chroot desde $installer" >&2
        exit 1
    fi
    bash -n "$chroot_test"
    grep -q '^install_xfce_desktop() {' "$chroot_test"
    grep -q '^configure_accounts() {' "$chroot_test"
    grep -q 'CONDTUX_ACCOUNT_OVERRIDE_V3' "$chroot_test"
    rm -f "$chroot_test"
done

for script in \
    /usr/local/sbin/condtux-time-sync \
    /usr/local/sbin/condtux-copy-system-target \
    /usr/local/bin/condtux-install-gui \
    /usr/local/bin/condtux-startxfce4; do
    sh -n "$script"
done

for package in xfce4 xfce4-session xfconf xfce4-settings xfdesktop4 xfwm4 lightdm; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
        echo "[ Condtux ] ERROR: paquete requerido incompleto: $package" >&2
        exit 1
    fi
done

for command_name in startxfce4 xfce4-session xfconf-query xfwm4 xfdesktop lightdm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "[ Condtux ] ERROR: comando requerido ausente: $command_name" >&2
        exit 1
    fi
done

XFCONFD_PATH="$(dpkg -L xfconf 2>/dev/null | awk '/\/xfconfd$/ { print; exit }')"
if [ -z "$XFCONFD_PATH" ] || [ ! -x "$XFCONFD_PATH" ]; then
    echo "[ Condtux ] ERROR: no se encontro el daemon xfconfd." >&2
    exit 1
fi
if [ ! -L /usr/local/bin/xfconfd ] || [ "$(readlink -f /usr/local/bin/xfconfd)" != "$(readlink -f "$XFCONFD_PATH")" ]; then
    echo "[ Condtux ] ERROR: el enlace de xfconfd no apunta al runtime de Debian." >&2
    exit 1
fi

DBUS_SERVICE=/usr/share/dbus-1/services/org.xfce.Xfconf.service
if [ ! -f "$DBUS_SERVICE" ] || ! grep -q '^Name=org\.xfce\.Xfconf$' "$DBUS_SERVICE"; then
    echo "[ Condtux ] ERROR: servicio D-Bus de xfconf ausente o invalido." >&2
    exit 1
fi

for binary in "$(command -v xfce4-session)" "$XFCONFD_PATH" "$(command -v xfwm4)"; do
    if ldd "$binary" 2>/dev/null | grep -q 'not found'; then
        echo "[ Condtux ] ERROR: bibliotecas sin resolver en $binary" >&2
        ldd "$binary" >&2 || true
        exit 1
    fi
done

if dpkg --audit | grep -q .; then
    echo "[ Condtux ] ERROR: dpkg detecto un estado inconsistente:" >&2
    dpkg --audit >&2
    exit 1
fi

if dpkg-query -W -f='${Status}' condtux-xfce-desktop 2>/dev/null | grep -q 'install ok installed'; then
    echo "[ Condtux ] ERROR: la ISO contiene el paquete XFCE monolitico antiguo." >&2
    exit 1
fi

for legacy in \
    /etc/profile.d/condtux-xfce.sh \
    /etc/X11/Xsession.d/55condtux-xfce-environment \
    /etc/ld.so.conf.d/condtux-xfce.conf; do
    if [ -e "$legacy" ]; then
        echo "[ Condtux ] ERROR: residuo XFCE monolitico detectado: $legacy" >&2
        exit 1
    fi
done

if [ -f /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml ] && \
   grep -q 'SaveOnExit' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml && \
   ! grep -q 'Failsafe' /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml; then
    echo "[ Condtux ] ERROR: xfce4-session.xml sigue ocultando la sesion segura." >&2
    exit 1
fi

echo "[ Condtux 0.11 ] ISO validada: XFCE, instalador, cuentas, hora, seguridad y dpkg correctos."