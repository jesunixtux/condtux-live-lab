#!/bin/sh
set -e

echo "[ Condtux ] Aplicando branding GRUB..."

find . -type f \( -name "*.cfg" -o -name "*.txt" -o -name "*.html" \) -print | while read -r file; do
    sed -i 's/Debian GNU\/Linux/Condtux/g' "$file" || true
    sed -i 's/Debian/Condtux/g' "$file" || true
    sed -i 's/Live system (amd64)/Iniciar Condtux Live/g' "$file" || true
    sed -i 's/Live system (amd64 fail-safe mode)/Iniciar Condtux modo seguro/g' "$file" || true
    sed -i 's/Start installer/Instalar Condtux/g' "$file" || true
    sed -i 's/Advanced install options/Opciones avanzadas de instalación/g' "$file" || true
    sed -i 's/Utilities/Herramientas/g' "$file" || true
done

echo "[ Condtux ] Branding GRUB aplicado."
