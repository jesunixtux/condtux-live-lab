#!/bin/sh
set -eu

echo "[ Condtux ] Aplicando branding GRUB 0.10..."

find . -type f \( -name "*.cfg" -o -name "*.txt" -o -name "*.html" \) -print | while read -r file; do
    sed -i 's/Debian GNU\/Linux 0\.[0-9][0-9]*/Condtux GNU\/Linux 0.10/g' "$file" || true
    sed -i 's/Debian GNU\/Linux/Condtux GNU\/Linux/g' "$file" || true
    sed -i 's/Debian/Condtux/g' "$file" || true
    sed -i 's/Condtux GNU\/Linux 0\.[0-9][0-9]*/Condtux GNU\/Linux 0.10/g' "$file" || true
    sed -i 's/Condtux 0\.[0-9][0-9]*/Condtux 0.10/g' "$file" || true
    sed -i 's/Live system (amd64)/Iniciar Condtux Live/g' "$file" || true
    sed -i 's/Live system (amd64 fail-safe mode)/Iniciar Condtux Live (modo seguro)/g' "$file" || true
    sed -i 's/Advanced install options/Opciones avanzadas/g' "$file" || true
    sed -i 's/Utilities/Herramientas utiles/g' "$file" || true
done

echo "[ Condtux ] Branding GRUB aplicado."
