#!/bin/sh
set -e

echo "[ Condtux ] Agregando entrada GRUB para instalacion desde Live..."

kernel="$(find live -maxdepth 1 -type f -name 'vmlinuz*' | sort | head -n 1)"
initrd="$(find live -maxdepth 1 -type f -name 'initrd.img*' | sort | head -n 1)"

if [ -z "$kernel" ] || [ -z "$initrd" ]; then
    echo "[ Condtux ] No se encontro kernel/initrd del Live; se omite entrada de instalacion."
    exit 0
fi

kernel="/${kernel#./}"
initrd="/${initrd#./}"

(find boot EFI -type f -name 'grub.cfg' 2>/dev/null || true) | while read -r cfg; do
    if grep -q 'Instalar Condtux desde Live' "$cfg"; then
        continue
    fi

    cat >> "$cfg" <<EOF

menuentry "Instalar Condtux desde Live" {
    linux $kernel boot=live components live-config.username=condtux live-config.user-fullname=Condtux hostname=condtux locales=es_CL.UTF-8 keyboard-layouts=latam timezone=America/Santiago condtux.install=1
    initrd $initrd
}
EOF
done

echo "[ Condtux ] Entrada GRUB de instalacion lista."
