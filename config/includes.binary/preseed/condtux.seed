# Condtux installer preseed

### Red
d-i netcfg/get_hostname string condtux
d-i netcfg/get_domain string local

### Mirror Debian temporal para instalación
# repo-condtux.jeval.cl todavía será repo principal dentro del sistema instalado,
# pero el instalador usa Debian para no romper la instalación mientras el repo propio no esté completo.
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### APT
d-i apt-setup/disable-cdrom-entries boolean true
d-i apt-setup/use_mirror boolean true
d-i apt-setup/non-free-firmware boolean false
d-i apt-setup/contrib boolean false
d-i apt-setup/non-free boolean false

### No telemetry Debian
popularity-contest popularity-contest/participate boolean false

### Software selection minimal
tasksel tasksel/first multiselect standard, ssh-server

### Paquetes base Condtux
d-i pkgsel/include string sudo openssh-server nano curl wget git ca-certificates unattended-upgrades apt-listchanges fastfetch network-manager whiptail

### Updates
d-i pkgsel/upgrade select safe-upgrade

### Late command Condtux
d-i preseed/late_command string \
in-target /bin/sh -c "echo condtux > /etc/hostname"; \
in-target /bin/sh -c "cat > /etc/hosts <<'HOSTS'\n127.0.0.1 localhost\n127.0.1.1 condtux\n\n::1 localhost ip6-localhost ip6-loopback\nff02::1 ip6-allnodes\nff02::2 ip6-allrouters\nHOSTS"; \
in-target /bin/sh -c "mkdir -p /etc/apt/sources.list.d /etc/apt/preferences.d"; \
in-target /bin/sh -c "cat > /etc/apt/sources.list <<'APT'\n# Condtux usa /etc/apt/sources.list.d/*.sources\nAPT"; \
in-target /bin/sh -c "cat > /etc/apt/sources.list.d/condtux.sources <<'APT'\nTypes: deb\nURIs: https://repo-condtux.jeval.cl/apt\nSuites: trixie\nComponents: main\nArchitectures: amd64\nTrusted: yes\n\nTypes: deb\nURIs: http://deb.debian.org/debian\nSuites: trixie trixie-updates\nComponents: main\nArchitectures: amd64\n\nTypes: deb\nURIs: http://security.debian.org/debian-security\nSuites: trixie-security\nComponents: main\nArchitectures: amd64\nAPT"; \
in-target /bin/sh -c "cat > /etc/apt/preferences.d/condtux.pref <<'PREF'\nPackage: *\nPin: origin repo-condtux.jeval.cl\nPin-Priority: 700\n\nPackage: *\nPin: release o=Debian\nPin-Priority: 500\nPREF"; \
in-target apt-get purge -y popularity-contest || true; \
in-target systemctl enable NetworkManager || true; \
in-target systemctl enable condtux-first-config.service || true
