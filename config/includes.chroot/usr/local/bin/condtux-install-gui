#!/bin/sh
set -eu

case "${LANG:-en}" in
    es*)
        TITLE="Instalar Condtux"
        INSTALLER="/usr/local/sbin/condtux-install"
        CLOSE_TEXT="Presiona Enter para cerrar..."
        ;;
    *)
        TITLE="Install Condtux"
        INSTALLER="/usr/local/sbin/condtux-install-en"
        CLOSE_TEXT="Press Enter to close..."
        ;;
esac

[ -x "$INSTALLER" ] || INSTALLER="/usr/local/sbin/condtux-install"

if command -v xterm >/dev/null 2>&1; then
    exec xterm -T "$TITLE" -geometry 112x36 -e sh -c 'sudo "$1"; printf "\n%s" "$2"; read answer' sh "$INSTALLER" "$CLOSE_TEXT"
fi

if command -v x-terminal-emulator >/dev/null 2>&1; then
    exec x-terminal-emulator -e sh -c 'sudo "$1"; printf "\nPress Enter / Presiona Enter..."; read answer' sh "$INSTALLER"
fi

echo "No graphical terminal found / No se encontro una terminal grafica." >&2
exit 1
