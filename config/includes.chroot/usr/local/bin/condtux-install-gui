#!/bin/sh
set -eu

case "${LANG:-en}" in
    es*)
        TITLE="Instalar Condtux"
        QUESTION="Se abrirá el instalador de Condtux en una ventana segura. ¿Quieres continuar?"
        ;;
    *)
        TITLE="Install Condtux"
        QUESTION="The Condtux installer will open in a secure window. Do you want to continue?"
        ;;
esac

if command -v zenity >/dev/null 2>&1; then
    zenity --question --title="$TITLE" --text="$QUESTION" --width=440 || exit 0
fi

if command -v xfce4-terminal >/dev/null 2>&1; then
    exec xfce4-terminal --hold --title="$TITLE" --command="sudo /usr/local/sbin/condtux-install"
fi

if command -v x-terminal-emulator >/dev/null 2>&1; then
    exec x-terminal-emulator -e sh -c 'sudo /usr/local/sbin/condtux-install; printf "\nPress Enter / Presiona Enter..."; read answer'
fi

echo "No graphical terminal found / No se encontro una terminal grafica." >&2
exit 1
