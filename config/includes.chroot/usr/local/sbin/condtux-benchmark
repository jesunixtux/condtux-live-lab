#!/bin/sh
set -eu

OUT="${1:-$HOME/condtux-benchmark.txt}"

{
    echo "Condtux benchmark"
    echo "================="
    date
    echo
    echo "Version:"
    cat /etc/condtux-version 2>/dev/null || true
    echo
    echo "Kernel:"
    uname -a
    echo
    echo "Clock synchronization:"
    timedatectl status 2>/dev/null || true
    echo
    echo "Secure Boot:"
    if command -v mokutil >/dev/null 2>&1; then
        mokutil --sb-state 2>/dev/null || true
    else
        echo "mokutil not installed"
    fi
    echo
    echo "Firewall:"
    systemctl is-enabled nftables.service 2>/dev/null || true
    nft list ruleset 2>/dev/null | sed -n '1,80p' || true
    echo
    echo "Memory:"
    free -h
    echo
    echo "Top RSS processes:"
    ps aux --sort=-rss | head -n 20
    echo
    echo "Running services:"
    systemctl --no-pager --state=running --type=service 2>/dev/null || true
    echo
    echo "Failed services:"
    systemctl --no-pager --failed 2>/dev/null || true
    echo
    echo "Boot time:"
    systemd-analyze 2>/dev/null || true
    echo
    echo "Root filesystem:"
    df -h /
} | tee "$OUT"

echo "Report saved to: $OUT"
