#!/usr/bin/env bash
set -e

# No ejecutar en sesión Live
if grep -q "boot=live" /proc/cmdline 2>/dev/null; then
    exit 0
fi

if systemctl is-active --quiet live-config.service 2>/dev/null; then
    exit 0
fi

DONE_FILE="/etc/condtux/first-config.done"
mkdir -p /etc/condtux

if [ -f "$DONE_FILE" ]; then
    exit 0
fi

LANG_CODE="${LANG:-en}"
if echo "$LANG_CODE" | grep -qi '^es'; then
    TXT_TITLE="Primera configuración de Condtux"
    TXT_ADMIN="¿Quieres que tu usuario principal tenga permisos de administrador con sudo?"
    TXT_ROOT="¿Quieres activar una cuenta root separada?"
    TXT_DESKTOP="¿Quieres instalar el escritorio XFCE de Condtux?"
    TXT_DONE="Configuración completada. Reinicia el sistema si instalaste XFCE."
    TXT_YES="Sí"
    TXT_NO="No"
else
    TXT_TITLE="Condtux First Configuration"
    TXT_ADMIN="Do you want your main user to have administrator permissions with sudo?"
    TXT_ROOT="Do you want to enable a separate root account?"
    TXT_DESKTOP="Do you want to install the Condtux XFCE desktop?"
    TXT_DONE="Configuration completed. Reboot the system if you installed XFCE."
    TXT_YES="Yes"
    TXT_NO="No"
fi

need_whiptail() {
    if ! command -v whiptail >/dev/null 2>&1; then
        apt-get update || true
        apt-get install -y whiptail || true
    fi
}

get_first_normal_user() {
    awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" {print $1; exit}' /etc/passwd
}

need_whiptail

MAIN_USER="$(get_first_normal_user || true)"

if [ -n "$MAIN_USER" ]; then
    if whiptail --title "$TXT_TITLE" --yesno "$TXT_ADMIN\n\nUsuario detectado: $MAIN_USER" 12 70; then
        apt-get update || true
        apt-get install -y sudo || true
        usermod -aG sudo "$MAIN_USER" || true
    fi
fi

if whiptail --title "$TXT_TITLE" --yesno "$TXT_ROOT" 10 70; then
    whiptail --title "$TXT_TITLE" --msgbox "Ahora define la contraseña de root en la terminal." 10 70 || true
    passwd root || true
else
    passwd -l root || true
fi

INSTALL_DESKTOP="no"

if whiptail --title "$TXT_TITLE" --yesno "$TXT_DESKTOP" 10 70; then
    INSTALL_DESKTOP="yes"
fi

if [ "$INSTALL_DESKTOP" = "yes" ]; then
    apt-get update

    if ! apt-cache show condtux-xfce-desktop >/dev/null 2>&1; then
        whiptail --title "$TXT_TITLE" --msgbox "No se encontro condtux-xfce-desktop en el repo Condtux. Publica el XFCE compilado desde xfce.org y vuelve a intentar." 12 70 || true
        exit 1
    fi

    apt-get install -y \
        condtux-xfce-desktop \
        xorg \
        lightdm \
        lightdm-gtk-greeter \
        network-manager-gnome \
        polkitd \
        pkexec \
        dbus-x11 \
        pavucontrol \
        pipewire-audio \
        fonts-dejavu \
        adwaita-icon-theme

    if ! command -v startxfce4 >/dev/null 2>&1; then
        whiptail --title "$TXT_TITLE" --msgbox "condtux-xfce-desktop no instalo startxfce4. Revisa el paquete del repo Condtux." 12 70 || true
        exit 1
    fi

    mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

    cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
EOF

    cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/condtux/defaultwallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/condtux/defaultwallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

    mkdir -p /usr/share/xsessions /etc/lightdm/lightdm.conf.d

    cat > /usr/share/xsessions/condtux-xfce.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Name=Condtux XFCE
Comment=Condtux desktop session
Exec=startxfce4
TryExec=startxfce4
Type=Application
DesktopNames=XFCE
EOF

    cat > /etc/lightdm/lightdm.conf.d/50-condtux.conf <<'EOF'
[Seat:*]
user-session=condtux-xfce
greeter-session=lightdm-gtk-greeter
EOF

    systemctl set-default graphical.target || true
    systemctl enable lightdm || true
fi

echo "$TXT_DONE"

date > "$DONE_FILE"

whiptail --title "$TXT_TITLE" --msgbox "$TXT_DONE" 10 70 || true

exit 0
