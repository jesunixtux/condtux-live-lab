#!/usr/bin/env bash
set -e

DONE_FILE="/etc/condtux/first-config.done"
mkdir -p /etc/condtux

if [ -f "$DONE_FILE" ]; then
    exit 0
fi

LANG_CODE="${LANG:-en}"
if echo "$LANG_CODE" | grep -qi '^es'; then
    TXT_TITLE="Primera configuración de Condtux"
    TXT_ADMIN="¿Quieres que tu usuario principal tenga permisos de administrador con sudo?"
    TXT_ROOT="¿Quieres activar una cuenta root separada?"
    TXT_DESKTOP="¿Quieres instalar una interfaz gráfica XFCE?"
    TXT_THEME="Elige el tema visual para XFCE"
    TXT_LIGHT="Claro"
    TXT_DARK="Oscuro"
    TXT_DONE="Configuración completada. Reinicia el sistema si instalaste XFCE."
    TXT_YES="Sí"
    TXT_NO="No"
else
    TXT_TITLE="Condtux First Configuration"
    TXT_ADMIN="Do you want your main user to have administrator permissions with sudo?"
    TXT_ROOT="Do you want to enable a separate root account?"
    TXT_DESKTOP="Do you want to install the XFCE graphical desktop?"
    TXT_THEME="Choose the visual theme for XFCE"
    TXT_LIGHT="Light"
    TXT_DARK="Dark"
    TXT_DONE="Configuration completed. Reboot the system if you installed XFCE."
    TXT_YES="Yes"
    TXT_NO="No"
fi

need_whiptail() {
    if ! command -v whiptail >/dev/null 2>&1; then
        apt-get update || true
        apt-get install -y whiptail || true
    fi
}

get_first_normal_user() {
    awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "nobody" {print $1; exit}' /etc/passwd
}

need_whiptail

MAIN_USER="$(get_first_normal_user || true)"

if [ -n "$MAIN_USER" ]; then
    if whiptail --title "$TXT_TITLE" --yesno "$TXT_ADMIN\n\nUsuario detectado: $MAIN_USER" 12 70; then
        apt-get update || true
        apt-get install -y sudo || true
        usermod -aG sudo "$MAIN_USER" || true
    fi
fi

if whiptail --title "$TXT_TITLE" --yesno "$TXT_ROOT" 10 70; then
    whiptail --title "$TXT_TITLE" --msgbox "Ahora define la contraseña de root en la terminal." 10 70 || true
    passwd root || true
else
    passwd -l root || true
fi

INSTALL_DESKTOP="no"

if whiptail --title "$TXT_TITLE" --yesno "$TXT_DESKTOP" 10 70; then
    INSTALL_DESKTOP="yes"
fi

if [ "$INSTALL_DESKTOP" = "yes" ]; then
    apt-get update

    apt-get install -y \
        xorg \
        xfce4 \
        xfce4-terminal \
        lightdm \
        lightdm-gtk-greeter \
        network-manager-gnome \
        policykit-1 \
        dbus-x11 \
        thunar \
        mousepad \
        ristretto \
        parole \
        pavucontrol \
        fonts-dejavu \
        adwaita-icon-theme \
        greybird-gtk-theme

    THEME_CHOICE="$(whiptail --title "$TXT_TITLE" --menu "$TXT_THEME" 15 70 2 \
        light "$TXT_LIGHT" \
        dark "$TXT_DARK" \
        3>&1 1>&2 2>&3 || echo light)"

    mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml

    if [ "$THEME_CHOICE" = "dark" ]; then
        GTK_THEME="Greybird-dark"
    else
        GTK_THEME="Greybird"
    fi

    cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="$GTK_THEME"/>
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
EOF

    systemctl set-default graphical.target || true
    systemctl enable lightdm || true
fi

echo "$TXT_DONE"

date > "$DONE_FILE"

whiptail --title "$TXT_TITLE" --msgbox "$TXT_DONE" 10 70 || true

exit 0
