install_condtux_repo_test() {
  if apt-cache show condtux-repo-test >/dev/null 2>&1; then
    apt install -y condtux-repo-test
  else
    echo "[ Condtux ] Aviso: condtux-repo-test no esta disponible en el repo Condtux."
  fi
}

install_if_available() {
  local pkg="$1"

  if apt-cache show "$pkg" >/dev/null 2>&1; then
    apt install -y "$pkg"
  else
    echo "[ Condtux ] Aviso: paquete opcional no disponible: $pkg"
  fi
}

install_optional_features() {
  local feature pkg

  for feature in $OPTIONAL_FEATURES; do
    case "$feature" in
      firmware)
        for pkg in firmware-linux-free wireless-regdb; do
          install_if_available "$pkg"
        done
        ;;
      bluetooth)
        for pkg in bluetooth bluez; do
          install_if_available "$pkg"
        done
        systemctl enable bluetooth >/dev/null 2>&1 || true
        ;;
      printing)
        for pkg in cups system-config-printer; do
          install_if_available "$pkg"
        done
        systemctl enable cups >/dev/null 2>&1 || true
        ;;
      vmguest)
        for pkg in qemu-guest-agent spice-vdagent open-vm-tools; do
          install_if_available "$pkg"
        done
        systemctl enable qemu-guest-agent >/dev/null 2>&1 || true
        systemctl enable spice-vdagentd >/dev/null 2>&1 || true
        systemctl enable open-vm-tools >/dev/null 2>&1 || true
        ;;
      "")
        ;;
      *)
        echo "[ Condtux ] Aviso: opcion desconocida ignorada: $feature"
        ;;
    esac
  done
}

install_xfce_desktop() {
  if ! apt-cache show "$CONDTUX_XFCE_PACKAGE" >/dev/null 2>&1; then
    echo "[ Condtux ] ERROR: falta $CONDTUX_XFCE_PACKAGE en https://repo-condtux.jeval.cl/apt" >&2
    echo "[ Condtux ] Publica el XFCE compilado desde https://xfce.org/ en el repo Condtux antes de usar este perfil." >&2
    exit 1
  fi

  apt install -y \
    "$CONDTUX_XFCE_PACKAGE" \
    xorg \
    lightdm \
    lightdm-gtk-greeter \
    network-manager-gnome \
    polkitd \
    pkexec \
    dbus-x11 \
    pavucontrol \
    pipewire-audio \
    fonts-dejavu \
    adwaita-icon-theme

  if ! command -v startxfce4 >/dev/null 2>&1; then
    echo "[ Condtux ] ERROR: $CONDTUX_XFCE_PACKAGE no instalo startxfce4." >&2
    exit 1
  fi

  mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
  mkdir -p /usr/share/xsessions /etc/lightdm/lightdm.conf.d

  cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'XFCE'
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="IconThemeName" type="string" value="Adwaita"/>
  </property>
</channel>
XFCE

  cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'XFCE'
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/condtux/defaultwallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/condtux/defaultwallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
XFCE

  cat > /usr/share/xsessions/condtux-xfce.desktop <<'XFCE'
[Desktop Entry]
Version=1.0
Name=Condtux XFCE
Comment=Condtux desktop session
Exec=startxfce4
TryExec=startxfce4
Type=Application
DesktopNames=XFCE
XFCE

  cat > /etc/lightdm/lightdm.conf.d/50-condtux.conf <<'LIGHTDM'
[Seat:*]
user-session=condtux-xfce
greeter-session=lightdm-gtk-greeter
LIGHTDM

  systemctl set-default graphical.target || true
  systemctl enable lightdm || true
}

configure_accounts() {
  if [ "$INSTALL_USERNAME" != "condtux" ] && id condtux >/dev/null 2>&1; then
    userdel -r condtux >/dev/null 2>&1 || true
  fi

  rm -f /etc/sudoers.d/condtux-live /etc/sudoers.d/condtux
  rm -rf /etc/systemd/system/getty@tty1.service.d

  if ! id "$INSTALL_USERNAME" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "$INSTALL_FULLNAME" "$INSTALL_USERNAME"
  fi

  printf '%s:%s\n' "$INSTALL_USERNAME" "$USER_PASSWORD_HASH" | chpasswd -e

  if [ "$ACCOUNT_MODE" = "root" ]; then
    gpasswd -d "$INSTALL_USERNAME" sudo >/dev/null 2>&1 || true
    printf 'root:%s\n' "$ROOT_PASSWORD_HASH" | chpasswd -e
  else
    usermod -aG sudo "$INSTALL_USERNAME"
    passwd -l root >/dev/null 2>&1 || true
  fi
}

install_condtux_repo_test
install_optional_features

if [ "$INSTALL_PROFILE" = "xfce" ]; then
  install_xfce_desktop
fi

echo condtux > /etc/hostname

cat > /etc/hosts <<'HOSTS'
