#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none

TITLE="Condtux Installer 0.9"
TARGET="/mnt"
DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="https://deb.debian.org/debian"
DEBIAN_SECURITY_MIRROR="https://security.debian.org/debian-security"
CONDTUX_REPO_URL="https://repo-condtux.jeval.cl/apt"
CONDTUX_KEYRING="/usr/share/keyrings/condtux-archive-keyring.gpg"
CONDTUX_XFCE_PACKAGE="condtux-xfce-desktop"
HOSTNAME="condtux"

INSTALL_PROFILE="minimal"
INSTALL_MODE="easy"
INSTALL_USERNAME="usuario"
INSTALL_FULLNAME="Usuario Condtux"
ACCOUNT_MODE="sudo"
OPTIONAL_FEATURES=""
EXPERT_FORMAT_ROOT="yes"
USER_PASSWORD_HASH=""
ROOT_PASSWORD_HASH=""

EFI_PART=""
ROOT_PART=""

has_whiptail() {
    command -v whiptail >/dev/null 2>&1 && [ -t 1 ]
}

read_password_masked() {
    local prompt="$1"
    local pass=""
    local char=""

    printf '%s\n> ' "$prompt" >&2
    stty -echo 2>/dev/null || true
    while IFS= read -r -s -n 1 char; do
        case "$char" in
            $'\n'|$'\r')
                break
                ;;
            $'\177'|$'\b')
                if [ -n "$pass" ]; then
                    pass="${pass%?}"
                    printf '\b \b' >&2
                fi
                ;;
            *)
                pass="${pass}${char}"
                printf '*' >&2
                ;;
        esac
    done
    stty echo 2>/dev/null || true
    printf '\n' >&2
    printf '%s\n' "$pass"
}

msg() {
    local text="$1"

    if has_whiptail; then
        whiptail --title "$TITLE" --msgbox "$text" 14 76
    else
        printf '\n%s\n\n' "$text"
    fi
}

yesno() {
    local text="$1"

    if has_whiptail; then
        whiptail --title "$TITLE" --yesno "$text" 16 78
    else
        printf '%s [s/N] ' "$text"
        read -r answer
        case "$answer" in
            s|S|si|SI|Si|yes|YES|Yes|y|Y) return 0 ;;
            *) return 1 ;;
        esac
    fi
}

inputbox() {
    local text="$1"
    local default_value="${2:-}"

    if has_whiptail; then
        whiptail --title "$TITLE" --inputbox "$text" 11 76 "$default_value" 3>&1 1>&2 2>&3
    else
        if [ -n "$default_value" ]; then
            printf '%s [%s]\n> ' "$text" "$default_value" >&2
        else
            printf '%s\n> ' "$text" >&2
        fi
        read -r answer
        printf '%s\n' "${answer:-$default_value}"
    fi
}

passwordbox() {
    local text="$1"

    if has_whiptail; then
        whiptail --title "$TITLE" --passwordbox "$text" 11 76 3>&1 1>&2 2>&3
    else
        read_password_masked "$text"
    fi
}

die() {
    local text="$1"

    printf 'ERROR: %s\n' "$text" >&2
    msg "$text" || true
    exit 1
}

profile_label() {
    case "$INSTALL_PROFILE" in
        xfce) printf 'Escritorio XFCE' ;;
        *) printf 'Minimal sin escritorio' ;;
    esac
}

install_mode_label() {
    case "$INSTALL_MODE" in
        expert) printf 'Experto con particiones manuales' ;;
        *) printf 'Facil con disco completo' ;;
    esac
}

account_mode_label() {
    case "$ACCOUNT_MODE" in
        root) printf 'Usuario normal + root separado' ;;
        *) printf 'Usuario administrador con sudo' ;;
    esac
}

select_install_mode() {
    local choice selected

    if has_whiptail; then
        if ! choice="$(whiptail --title "$TITLE" --menu "Elige el modo de instalacion.\n\nFacil usa disco completo. Experto permite elegir particiones EFI/root existentes." 18 78 2 \
            easy "Facil: borrar disco completo y particionar automaticamente" \
            expert "Experto: elegir particion EFI y root manualmente" \
            3>&1 1>&2 2>&3)"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        INSTALL_MODE="$choice"
        return 0
    fi

    echo "Modo de instalacion:" >&2
    echo "  1) Facil: disco completo automatico" >&2
    echo "  2) Experto: particiones manuales" >&2
    printf 'Seleccion [1]: ' >&2
    read -r selected

    case "${selected:-1}" in
        1|easy|facil|Facil) INSTALL_MODE="easy" ;;
        2|expert|experto|Experto) INSTALL_MODE="expert" ;;
        *) die "Modo de instalacion invalido." ;;
    esac
}

select_install_profile() {
    local choice selected

    if has_whiptail; then
        if ! choice="$(whiptail --title "$TITLE" --menu "Elige como quieres instalar Condtux 0.9.\n\nEsto se define antes de tocar el disco." 17 78 2 \
            minimal "Minimal sin escritorio, ideal para terminal o servidor" \
            xfce "Escritorio XFCE de Condtux con LightDM" \
            3>&1 1>&2 2>&3)"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        INSTALL_PROFILE="$choice"
        return 0
    fi

    echo "Perfil de instalacion:" >&2
    echo "  1) Minimal sin escritorio" >&2
    echo "  2) Escritorio XFCE" >&2
    printf 'Seleccion [1]: ' >&2
    read -r selected

    case "${selected:-1}" in
        1|minimal|Minimal) INSTALL_PROFILE="minimal" ;;
        2|xfce|XFCE|Xfce) INSTALL_PROFILE="xfce" ;;
        *) die "Perfil de instalacion invalido." ;;
    esac
}

select_optional_features() {
    local choice selected

    OPTIONAL_FEATURES=""

    if has_whiptail; then
        choice="$(whiptail --title "$TITLE" --checklist "Soporte opcional para tecnologias nuevas.\n\nPuedes dejar todo desmarcado para una instalacion limpia." 20 78 8 \
            firmware "Firmware libre y base wireless" off \
            bluetooth "Bluetooth con BlueZ" off \
            printing "Impresion con CUPS" off \
            vmguest "Agentes para VM: QEMU/SPICE/Open VM Tools" off \
            3>&1 1>&2 2>&3 || true)"
        OPTIONAL_FEATURES="$(printf '%s\n' "$choice" | tr -d '"' | xargs 2>/dev/null || true)"
        return 0
    fi

    echo "Soporte opcional:" >&2
    echo "  firmware   Firmware libre y base wireless" >&2
    echo "  bluetooth  Bluetooth con BlueZ" >&2
    echo "  printing   Impresion con CUPS" >&2
    echo "  vmguest    Agentes para VM: QEMU/SPICE/Open VM Tools" >&2
    printf 'Opciones separadas por espacio [ninguna]: ' >&2
    read -r selected
    OPTIONAL_FEATURES="$selected"
}

validate_username() {
    local value="$1"

    [[ "$value" =~ ^[a-z_][a-z0-9_-]*$ ]] || return 1
    case "$value" in
        root|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|gnats|nobody|_apt)
            return 1
            ;;
    esac
}

ask_username() {
    local value

    while true; do
        if ! value="$(inputbox "Nombre de usuario para el sistema instalado.\n\nUsa minusculas, numeros, guion o guion bajo." "$INSTALL_USERNAME")"; then
            echo "Instalacion cancelada."
            exit 0
        fi

        if validate_username "$value"; then
            INSTALL_USERNAME="$value"
            INSTALL_FULLNAME="$(printf 'Usuario %s' "$INSTALL_USERNAME")"
            return 0
        fi

        msg "Nombre de usuario invalido.\n\nEjemplo valido: jesus, condtux, usuario_1"
    done
}

ask_password_hash() {
    local label="$1"
    local pass1 pass2

    while true; do
        if ! pass1="$(passwordbox "Password para $label")"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        if ! pass2="$(passwordbox "Repite el password para $label")"; then
            echo "Instalacion cancelada."
            exit 0
        fi

        if [ -z "$pass1" ]; then
            msg "El password no puede quedar vacio."
            continue
        fi
        if [ "$pass1" != "$pass2" ]; then
            msg "Los passwords no coinciden. Intenta nuevamente."
            continue
        fi

        printf '%s' "$pass1" | openssl passwd -6 -stdin
        unset pass1 pass2
        return 0
    done
}

select_account_mode() {
    local choice selected

    if has_whiptail; then
        if ! choice="$(whiptail --title "$TITLE" --menu "Elige como administrar el sistema instalado." 17 78 2 \
            sudo "Mi usuario sera administrador con sudo; root queda bloqueado" \
            root "Mi usuario sera normal y root tendra password separado" \
            3>&1 1>&2 2>&3)"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        ACCOUNT_MODE="$choice"
        return 0
    fi

    echo "Modo de administracion:" >&2
    echo "  1) Mi usuario administra con sudo (root bloqueado)" >&2
    echo "  2) Usuario normal + cuenta root separada" >&2
    printf 'Seleccion [1]: ' >&2
    read -r selected

    case "${selected:-1}" in
        1|sudo|SUDO) ACCOUNT_MODE="sudo" ;;
        2|root|ROOT) ACCOUNT_MODE="root" ;;
        *) die "Modo de administracion invalido." ;;
    esac
}

collect_account_settings() {
    local fullname

    ask_username

    if ! fullname="$(inputbox "Nombre visible del usuario." "$INSTALL_FULLNAME")"; then
        echo "Instalacion cancelada."
        exit 0
    fi
    INSTALL_FULLNAME="${fullname:-$INSTALL_FULLNAME}"
    INSTALL_FULLNAME="${INSTALL_FULLNAME//:/ }"

    USER_PASSWORD_HASH="$(ask_password_hash "el usuario $INSTALL_USERNAME")"

    select_account_mode

    if [ "$ACCOUNT_MODE" = "root" ]; then
        ROOT_PASSWORD_HASH="$(ask_password_hash "root")"
    else
        ROOT_PASSWORD_HASH=""
    fi
}

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Ejecuta: sudo condtux-install"
        exit 1
    fi
}

check_amd64() {
    if [ "$(uname -m)" != "x86_64" ]; then
        die "Este instalador solo soporta amd64/x86_64."
    fi
}

check_uefi() {
    if [ ! -d /sys/firmware/efi ]; then
        die "Este instalador solo soporta arranque UEFI. Arranca la VM/PC en modo UEFI e intenta nuevamente."
    fi
}

require_commands() {
    local missing=()
    local cmd

    for cmd in debootstrap parted mkfs.vfat mkfs.ext4 wipefs sgdisk partprobe lsblk blkid chroot mount umount findmnt curl openssl rsync; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        die "Faltan herramientas requeridas en el Live: ${missing[*]}"
    fi
}

debian_repo_available() {
    curl -fsI --connect-timeout 8 --max-time 15 "$DEBIAN_MIRROR/dists/$DEBIAN_SUITE/InRelease" >/dev/null 2>&1
}

condtux_repo_available() {
    curl -fsI --connect-timeout 8 --max-time 15 "$CONDTUX_REPO_URL/dists/$DEBIAN_SUITE/Release" >/dev/null 2>&1
}

network_available() {
    debian_repo_available || return 1

    if [ "$INSTALL_PROFILE" = "xfce" ]; then
        condtux_repo_available || return 1
    fi

    return 0
}

start_network_services() {
    local ethernet_device=""

    if command -v systemctl >/dev/null 2>&1; then
        systemctl start NetworkManager >/dev/null 2>&1 || true
    fi

    if command -v nmcli >/dev/null 2>&1; then
        nmcli networking on >/dev/null 2>&1 || true
        nmcli radio wifi on >/dev/null 2>&1 || true
        ethernet_device="$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "ethernet" {print $1; exit}' || true)"
        if [ -n "$ethernet_device" ]; then
            nmcli device connect "$ethernet_device" >/dev/null 2>&1 || true
        fi
    fi
}

configure_network_if_needed() {
    if network_available; then
        echo "[ Condtux ] Internet disponible; se omite configuracion de red."
        return 0
    fi

    start_network_services
    sleep 3

    if network_available; then
        echo "[ Condtux ] Internet disponible despues de activar NetworkManager."
        return 0
    fi

    if yesno "No se detecto internet suficiente para este perfil.\n\nCondtux necesita descargar Debian trixie por HTTPS. El perfil XFCE tambien necesita el repo Condtux por HTTPS.\n\nQuieres abrir el asistente de red de NetworkManager?"; then
        if command -v nmtui-connect >/dev/null 2>&1; then
            nmtui-connect || true
        elif command -v nmtui >/dev/null 2>&1; then
            nmtui || true
        else
            msg "No esta disponible nmtui.\n\nConecta red por cable o configura Wi-Fi manualmente y vuelve a ejecutar sudo condtux-install."
        fi
    fi

    if ! network_available; then
        die "No se pudo contactar los repos HTTPS necesarios para el perfil elegido. Conecta internet antes de instalar."
    fi
}

part_name() {
    local disk="$1"
    local num="$2"

    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s\n' "$disk" "$num"
    else
        printf '%s%s\n' "$disk" "$num"
    fi
}

disk_line() {
    local disk="$1"

    lsblk -d -n -p -o NAME,SIZE,MODEL "$disk" 2>/dev/null | sed 's/[[:space:]][[:space:]]*/ /g'
}

disk_children() {
    local disk="$1"

    lsblk -n -p -o NAME,SIZE,FSTYPE,MOUNTPOINT "$disk" 2>/dev/null | sed -n '1,12p'
}

menu_disk() {
    local menu=()
    local name size type rm ro model desc choice idx selected

    while read -r name size type rm ro model; do
        [ "$type" = "disk" ] || continue
        [ "$ro" = "0" ] || continue
        [ -b "$name" ] || continue

        desc="$size"
        if [ -n "${model:-}" ]; then
            desc="$desc $model"
        fi
        if [ "$rm" = "1" ]; then
            desc="$desc removable"
        fi

        menu+=("$name" "$desc")
    done < <(lsblk -d -n -p -o NAME,SIZE,TYPE,RM,RO,MODEL)

    if [ "${#menu[@]}" -eq 0 ]; then
        die "No se detectaron discos instalables."
    fi

    if has_whiptail; then
        if ! choice="$(whiptail --title "$TITLE" --menu "Selecciona el disco donde instalar Condtux.\n\nEl disco elegido se borrara completo." 22 78 12 "${menu[@]}" 3>&1 1>&2 2>&3)"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        printf '%s\n' "$choice"
        return 0
    fi

    echo "Discos detectados:" >&2
    idx=1
    for ((i = 0; i < ${#menu[@]}; i += 2)); do
        printf '  %d) %s - %s\n' "$idx" "${menu[$i]}" "${menu[$((i + 1))]}" >&2
        idx=$((idx + 1))
    done
    printf 'Seleccion: ' >&2
    read -r selected

    if ! [[ "$selected" =~ ^[0-9]+$ ]]; then
        die "Seleccion invalida."
    fi
    if [ "$selected" -lt 1 ] || [ "$selected" -gt $(( ${#menu[@]} / 2 )) ]; then
        die "Seleccion fuera de rango."
    fi

    printf '%s\n' "${menu[$(( (selected - 1) * 2 ))]}"
}

confirm_disk_choice() {
    local disk="$1"
    local profile mode summary layout

    profile="$(profile_label)"
    mode="$(account_mode_label)"
    summary="$(disk_line "$disk")"
    layout="$(disk_children "$disk")"

    if ! yesno "Confirma el disco de instalacion.\n\nDisco seleccionado:\n$summary\n\nContenido actual:\n$layout\n\nModo: $(install_mode_label)\nPerfil: $profile\nUsuario: $INSTALL_USERNAME\nPermisos: $mode\n\nCondtux creara:\n- EFI FAT32 512 MiB\n- root ext4 con el resto del disco\n\nEsto borrara todo el disco seleccionado.\n\nEstas seguro de que este es el disco correcto?"; then
        echo "Instalacion cancelada."
        exit 0
    fi
}

partition_line() {
    local part="$1"

    lsblk -n -p -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$part" 2>/dev/null | sed 's/[[:space:]][[:space:]]*/ /g'
}

menu_partition() {
    local title="$1"
    local hint="$2"
    local menu=()
    local name size type fstype label mountpoint desc choice idx selected

    while read -r name size type fstype label mountpoint; do
        [ "$type" = "part" ] || continue
        [ -b "$name" ] || continue
        desc="$size"
        [ -n "${fstype:-}" ] && desc="$desc $fstype"
        [ -n "${label:-}" ] && desc="$desc $label"
        [ -n "${mountpoint:-}" ] && desc="$desc mounted:$mountpoint"
        menu+=("$name" "$desc")
    done < <(lsblk -n -p -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT)

    if [ "${#menu[@]}" -eq 0 ]; then
        die "No se detectaron particiones para modo experto."
    fi

    if has_whiptail; then
        if ! choice="$(whiptail --title "$TITLE" --menu "$title\n\n$hint" 22 78 12 "${menu[@]}" 3>&1 1>&2 2>&3)"; then
            echo "Instalacion cancelada."
            exit 0
        fi
        printf '%s\n' "$choice"
        return 0
    fi

    echo "$title" >&2
    echo "$hint" >&2
    idx=1
    for ((i = 0; i < ${#menu[@]}; i += 2)); do
        printf '  %d) %s - %s\n' "$idx" "${menu[$i]}" "${menu[$((i + 1))]}" >&2
        idx=$((idx + 1))
    done
    printf 'Seleccion: ' >&2
    read -r selected

    if ! [[ "$selected" =~ ^[0-9]+$ ]]; then
        die "Seleccion invalida."
    fi
    if [ "$selected" -lt 1 ] || [ "$selected" -gt $(( ${#menu[@]} / 2 )) ]; then
        die "Seleccion fuera de rango."
    fi

    printf '%s\n' "${menu[$(( (selected - 1) * 2 ))]}"
}

select_expert_partitions() {
    EFI_PART="$(menu_partition "Selecciona la particion EFI existente" "Debe ser FAT32/vfat y sera montada en /boot/efi. No se formateara.")"
    ROOT_PART="$(menu_partition "Selecciona la particion root" "Sera montada en /. Puedes formatearla ext4 o reutilizarla bajo tu responsabilidad.")"

    if [ "$EFI_PART" = "$ROOT_PART" ]; then
        die "La particion EFI y root no pueden ser la misma."
    fi

    if ! yesno "Modo experto.\n\nEFI: $(partition_line "$EFI_PART")\nROOT: $(partition_line "$ROOT_PART")\n\nQuieres formatear la particion root como ext4?\n\nRecomendado para instalacion limpia."; then
        EXPERT_FORMAT_ROOT="no"
    fi

    if ! yesno "Confirma instalacion experta.\n\nEFI: $EFI_PART\nROOT: $ROOT_PART\nFormatear root: $EXPERT_FORMAT_ROOT\n\nCondtux montara estas particiones en $TARGET y escribira el sistema alli.\n\nEstas seguro?"; then
        echo "Instalacion cancelada."
        exit 0
    fi
}

ensure_target_free() {
    if mountpoint -q "$TARGET"; then
        die "$TARGET ya esta montado. Desmontalo antes de ejecutar el instalador."
    fi
}

ensure_disk_not_in_use() {
    local disk="$1"

    if lsblk -nr -o MOUNTPOINT "$disk" | grep -q '/'; then
        die "El disco $disk tiene particiones montadas. Desmontalo antes de instalar."
    fi
}

wait_for_partitions() {
    local disk="$1"
    local i

    for i in $(seq 1 20); do
        if [ -b "$EFI_PART" ] && [ -b "$ROOT_PART" ]; then
            return 0
        fi
        partprobe "$disk" >/dev/null 2>&1 || true
        if command -v udevadm >/dev/null 2>&1; then
            udevadm settle >/dev/null 2>&1 || true
        fi
        sleep 1
    done

    die "No aparecieron las particiones esperadas: $EFI_PART y $ROOT_PART"
}

cleanup_mounts() {
    set +e

    if mountpoint -q "$TARGET"; then
        umount -R "$TARGET" >/dev/null 2>&1 || true
    fi
}

write_target_files() {
    local root_uuid
    local efi_uuid

    root_uuid="$(blkid -s UUID -o value "$ROOT_PART")"
    efi_uuid="$(blkid -s UUID -o value "$EFI_PART")"

    cat > "$TARGET/etc/apt/sources.list" <<SRC
deb $DEBIAN_MIRROR trixie main
deb $DEBIAN_MIRROR trixie-updates main
deb $DEBIAN_SECURITY_MIRROR trixie-security main
SRC

    cat > "$TARGET/etc/fstab" <<FSTAB
UUID=$root_uuid / ext4 defaults,noatime 0 1
UUID=$efi_uuid /boot/efi vfat umask=0077 0 1
FSTAB
}

configure_condtux_repo_target() {
    local target_keyring="$TARGET/usr/share/keyrings/condtux-archive-keyring.gpg"

    mkdir -p "$TARGET/usr/share/keyrings" "$TARGET/etc/apt/sources.list.d"

    if [ -f "$CONDTUX_KEYRING" ]; then
        cp -f "$CONDTUX_KEYRING" "$target_keyring"
    elif ! curl -fsSL --connect-timeout 20 "$CONDTUX_REPO_URL/condtux-archive-keyring.gpg" -o "$target_keyring"; then
        echo "[ Condtux ] Aviso: no se pudo instalar la llave del repo Condtux. Se continuara con repos Debian."
        rm -f "$target_keyring"
        return 0
    fi

    chmod 0644 "$target_keyring"

    cat > "$TARGET/etc/apt/sources.list.d/condtux.sources" <<SRC
Types: deb
URIs: $CONDTUX_REPO_URL
Suites: trixie
Components: main
Architectures: amd64
Signed-By: /usr/share/keyrings/condtux-archive-keyring.gpg
SRC
}

copy_condtux_assets_target() {
    if [ -d /usr/share/backgrounds/condtux ]; then
        mkdir -p "$TARGET/usr/share/backgrounds/condtux"
        rsync -a /usr/share/backgrounds/condtux/ "$TARGET/usr/share/backgrounds/condtux/"
    fi
}

mount_chroot_filesystems() {
    mkdir -p "$TARGET/dev" "$TARGET/proc" "$TARGET/sys" "$TARGET/run" "$TARGET/sys/firmware/efi/efivars"
    mount --rbind /dev "$TARGET/dev"
    mount --make-rslave "$TARGET/dev"
    mount -t proc proc "$TARGET/proc"
    mount -t sysfs sys "$TARGET/sys"
    mount --make-rslave "$TARGET/sys"
    mount --rbind /run "$TARGET/run"
    mount --make-rslave "$TARGET/run"
    mount -t efivarfs efivarfs "$TARGET/sys/firmware/efi/efivars" 2>/dev/null || true
}

write_install_answers() {
    {
        printf 'INSTALL_PROFILE=%q\n' "$INSTALL_PROFILE"
        printf 'INSTALL_USERNAME=%q\n' "$INSTALL_USERNAME"
        printf 'INSTALL_FULLNAME=%q\n' "$INSTALL_FULLNAME"
        printf 'ACCOUNT_MODE=%q\n' "$ACCOUNT_MODE"
        printf 'OPTIONAL_FEATURES=%q\n' "$OPTIONAL_FEATURES"
        printf 'USER_PASSWORD_HASH=%q\n' "$USER_PASSWORD_HASH"
        printf 'ROOT_PASSWORD_HASH=%q\n' "$ROOT_PASSWORD_HASH"
    } > "$TARGET/tmp/condtux-install-answers"
    chmod 0600 "$TARGET/tmp/condtux-install-answers"
}

create_chroot_setup_script() {
    cat > "$TARGET/tmp/condtux-chroot-setup.sh" <<'CHROOT'
#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export APT_LISTCHANGES_FRONTEND=none
CONDTUX_XFCE_PACKAGE="condtux-xfce-desktop"

if [ ! -f /tmp/condtux-install-answers ]; then
    echo "Falta /tmp/condtux-install-answers" >&2
    exit 1
fi

# shellcheck disable=SC1091
. /tmp/condtux-install-answers

case "$INSTALL_PROFILE" in
  xfce)
    CONDTUX_FLAVOR="XFCE"
    ;;
  *)
    INSTALL_PROFILE="minimal"
    CONDTUX_FLAVOR="Minimal"
    ;;
esac

cat > /tmp/condtux-debconf.selections <<'DEBCONF'
locales locales/default_environment_locale select es_CL.UTF-8
locales locales/locales_to_be_generated multiselect es_CL.UTF-8 UTF-8, en_US.UTF-8 UTF-8
keyboard-configuration keyboard-configuration/modelcode string pc105
keyboard-configuration keyboard-configuration/layoutcode string latam
keyboard-configuration keyboard-configuration/variantcode string
