#!/bin/sh
set -eu

if ! grep -qw 'boot=live' /proc/cmdline 2>/dev/null; then
    exit 0
fi

MARKER="/run/condtux-live-setup.done"

if [ -f "$MARKER" ]; then
    exit 0
fi

mkdir -p /run
printf '\033c\033[?25l'
printf '\n  Condtux 0.11 Live\n  First setup / Configuracion inicial\n\n'
/usr/local/sbin/condtux-language --live

# La sincronizacion continua en segundo plano mientras aparece la sesion Live.
systemctl start condtux-time-sync.service >/dev/null 2>&1 &

touch "$MARKER"
printf '\033c\033[?25h'
