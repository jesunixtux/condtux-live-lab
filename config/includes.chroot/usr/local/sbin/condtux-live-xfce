#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Ejecuta: sudo condtux-live-xfce" >&2
    exit 1
fi

if ! command -v startxfce4 >/dev/null 2>&1; then
    echo "[ Condtux ] XFCE no esta instalado en este Live." >&2
    exit 1
fi

echo "[ Condtux ] Activando XFCE en esta sesion Live..."

systemctl set-default graphical.target >/dev/null 2>&1 || true
systemctl enable lightdm >/dev/null 2>&1 || true

if systemctl start lightdm; then
    echo "[ Condtux ] XFCE activado."
else
    echo "[ Condtux ] No se pudo iniciar LightDM automaticamente." >&2
    echo "[ Condtux ] Intenta: sudo systemctl start lightdm" >&2
    exit 1
fi
