#!/bin/sh
set -u

MODE="${1:---boot}"
case "$MODE" in
    --wait) WAIT_SECONDS=60 ;;
    *) WAIT_SECONDS=15 ;;
esac

log() {
    printf '[ Condtux Time ] %s\n' "$*"
}

is_synced() {
    [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" = "yes" ]
}

valid_epoch() {
    value="$1"
    # 2025-01-01 .. 2038-01-01. Evita aceptar fechas absurdas de una BIOS dañada.
    [ "$value" -ge 1735689600 ] 2>/dev/null && [ "$value" -le 2145916800 ] 2>/dev/null
}

http_epoch() {
    url="$1"
    header="$(curl -kfsSI --connect-timeout 5 --max-time 10 "$url" 2>/dev/null | sed -n 's/^[Dd]ate:[[:space:]]*//p' | tr -d '\r' | tail -n1)"
    [ -n "$header" ] || return 1
    date -u -d "$header" +%s 2>/dev/null
}

# systemd-timesyncd no depende de que el reloj TLS sea correcto.
timedatectl set-ntp true >/dev/null 2>&1 || true
systemctl unmask systemd-timesyncd.service >/dev/null 2>&1 || true
systemctl restart systemd-timesyncd.service >/dev/null 2>&1 || true

elapsed=0
while [ "$elapsed" -lt "$WAIT_SECONDS" ]; do
    if is_synced; then
        log "Hora sincronizada mediante NTP: $(date -R)"
        if ! grep -qw 'boot=live' /proc/cmdline 2>/dev/null; then
            hwclock --systohc >/dev/null 2>&1 || true
        fi
        exit 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

# Rescate para equipos con una fecha de BIOS tan incorrecta que rompe HTTPS.
# Exige que dos servidores Debian entreguen horas con menos de 5 minutos de diferencia.
now_epoch="$(date -u +%s 2>/dev/null || printf 0)"
if ! valid_epoch "$now_epoch"; then
    epoch_a="$(http_epoch https://deb.debian.org 2>/dev/null || printf 0)"
    epoch_b="$(http_epoch https://security.debian.org 2>/dev/null || printf 0)"

    if valid_epoch "$epoch_a" && valid_epoch "$epoch_b"; then
        difference=$((epoch_a - epoch_b))
        [ "$difference" -lt 0 ] && difference=$((-difference))

        if [ "$difference" -le 300 ]; then
            date -u -s "@$epoch_a" >/dev/null 2>&1 || true
            systemctl restart systemd-timesyncd.service >/dev/null 2>&1 || true
            log "Reloj corregido desde dos fuentes Debian: $(date -R)"
            exit 0
        fi
    fi
fi

log "No se pudo confirmar NTP. La instalación avisará si la fecha impide validar los repositorios."
exit 0
