# =====================================================================
# Condtux Installer Preseed
# Condtux Minimal Orange / Debian 13 trixie amd64
# =====================================================================

### Localización
d-i debian-installer/locale string es_CL.UTF-8
d-i debian-installer/language string es
d-i debian-installer/country string CL
d-i debian-installer/locale select es_CL.UTF-8
d-i localechooser/supported-locales multiselect es_CL.UTF-8, en_US.UTF-8

### Teclado
d-i keyboard-configuration/xkb-keymap select latam
d-i keyboard-configuration/layoutcode string latam
d-i console-setup/ask_detect boolean false

### Zona horaria
d-i time/zone string America/Santiago
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

### Red
d-i netcfg/get_hostname string condtux
d-i netcfg/hostname string condtux
d-i netcfg/get_domain string local

### Mirror Debian para instalación
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

### APT instalador
d-i apt-setup/disable-cdrom-entries boolean true
d-i apt-setup/use_mirror boolean true
d-i apt-setup/contrib boolean false
d-i apt-setup/non-free boolean false
d-i apt-setup/non-free-firmware boolean false
d-i apt-setup/security_host string security.debian.org
d-i apt-setup/security_path string /debian-security

### Sin popularity-contest
popularity-contest popularity-contest/participate boolean false

### Software base, sin escritorio por defecto
tasksel tasksel/first multiselect standard, ssh-server

### Paquetes base Condtux
d-i pkgsel/include string sudo openssh-server nano curl wget git ca-certificates unattended-upgrades apt-listchanges bash-completion fastfetch network-manager whiptail locales console-setup keyboard-configuration iproute2 iputils-ping pciutils usbutils util-linux less

### Actualizaciones durante instalación
d-i pkgsel/upgrade select safe-upgrade

### GRUB
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true

### Ejecutar post-instalación Condtux
d-i preseed/late_command string cp /cdrom/preseed/condtux-late.sh /target/root/condtux-late.sh; chmod +x /target/root/condtux-late.sh; in-target /bin/sh /root/condtux-late.sh; rm -f /target/root/condtux-late.sh

### Final
d-i finish-install/reboot_in_progress note
